#!/usr/bin/env bash
# Reads a reviewer's answer into findings the gate can act on: one line per
# finding with a severity, a type, a file, a line range and the finding's first
# line. Called by SKILL.md, which sits beside it.
#
# It lives beside SKILL.md for the reasons ship-guard does: the skill folder is
# installed or copied as one unit and the helper travels with it, and /ship runs
# inside a project that knows nothing about where the skill came from. So it
# sources nothing and carries its own finding().
set -u

finding() { printf 'finding: %s\n' "$*" >&2; exit 2; }

usage="usage: ship-findings parse | label <base> | record [<pass>] | prior"

# The answer on stdin, as the reviewer wrote it. What is read is the region
# under a literal "## Findings" header up to the next "## " header, so a
# step 7 answer's "## Checked clean" list never reads as findings.
#
# The region is cut into blocks. A blank line ends one. A numbered item, a
# "###" heading, and a bullet at the left margin start one, except that a
# bullet directly under a numbered item or a heading is that finding's detail:
# Claude writes "**1. High: ...**" and puts the attack and the fix in bullets
# under it, and Codex writes one bullet per finding.
#
# From each block: the severity is the first of Critical, High, Important,
# Medium or Low on the block's first line, or in the whole block when the first
# line has none; the location is the first file:line token read the same way,
# a token being a path holding "/" or "." followed by ":digits" or
# ":digits-digits", with backticks, brackets and stars stripped. Two different
# severities, or two different locations, on the line or lines that supply them
# is a refusal and never a guess: the gate cannot label a finding it cannot
# place. The type is the text after a "Type:" label anywhere in the block.
#
# Missing header: refusal. Header with nothing under it: refusal. The single
# line "No findings." under it: nothing printed, exit 0. Absence is never read
# as clean, by anything here.
parse() {
  awk '
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
    function clean_token(t) {
      gsub(/[`()\[\]*,;]/, "", t)
      sub(/[.:]+$/, "", t)
      return t
    }
    # The severity words of a line, in order, as one space-separated string of
    # distinct words in their first-seen spelling. Whole words only, any case.
    function severities(line,   n, w, i, out, k, seen) {
      n = split(line, w, /[^A-Za-z]+/)
      out = ""; delete seen
      for (i = 1; i <= n; i++) {
        k = tolower(w[i])
        if (k == "critical" || k == "high" || k == "important" || k == "medium" || k == "low") {
          if (!(k in seen)) { seen[k] = 1; out = out (out == "" ? "" : " ") w[i] }
        }
      }
      return out
    }
    # The locations of a line, in order, distinct.
    function locations(line,   n, w, i, t, out, seen) {
      n = split(line, w, /[ \t]+/)
      out = ""; delete seen
      for (i = 1; i <= n; i++) {
        t = clean_token(w[i])
        if (t ~ /^[^:]*[\/.][^:]*:[0-9]+(-[0-9]+)?$/ && !(t in seen)) {
          seen[t] = 1; out = out (out == "" ? "" : " ") t
        }
      }
      return out
    }
    function first_of(a, b) { return a != "" ? a : b }
    function emit(   sev, loc, typ, text, line, i, n, lines, first, whole, s, l, parts, p, file, range, rest) {
      if (block == "") return
      if (sentinel && nfound == 0 && trim(block) == "No findings.") { block = ""; opener = ""; return }
      nfound++
      n = split(block, lines, "\n")
      first = lines[1]
      sev = severities(first); loc = locations(first)
      if (sev == "") sev = severities(block)
      if (loc == "") loc = locations(block)
      if (split(sev, parts, " ") > 1) {
        printf "finding: finding %d carries two severities (%s, %s); keep one\n", nfound, parts[1], parts[2] > "/dev/stderr"
        bad = 1; exit 2
      }
      if (split(loc, parts, " ") > 1) {
        printf "finding: finding %d names two locations (%s, %s); split it, one location each\n", nfound, parts[1], parts[2] > "/dev/stderr"
        bad = 1; exit 2
      }
      typ = "none"
      for (i = 1; i <= n; i++) {
        line = lines[i]
        if (match(line, /(^|[^A-Za-z])Type:/)) {
          rest = substr(line, RSTART + RLENGTH)
          gsub(/\*/, "", rest); rest = trim(rest)
          if (rest != "") typ = rest
          break
        }
      }
      if (sev == "") sev = "none"
      if (loc == "") { file = "-"; range = "0" }
      else { p = index(loc, ":"); file = substr(loc, 1, p - 1); range = substr(loc, p + 1) }
      text = trim(first); gsub(/\t/, " ", text); gsub(/\t/, " ", typ)
      out = out sprintf("%s\t%s\t%s\t%s\t%s\n", sev, typ, file, range, text)
      block = ""; opener = ""
    }
    BEGIN { inside = 0; seen_header = 0; block = ""; opener = ""; nfound = 0; content = 0; bad = 0; sentinel = 0; out = "" }
    /^## Findings[ \t]*$/ && !seen_header { seen_header = 1; inside = 1; next }
    /^## / { if (inside) { emit(); inside = 0 } next }
    !inside { next }
    {
      line = $0
      if (trim(line) == "") { emit(); next }
      content++
      if (content == 1 && trim(line) == "No findings.") { sentinel = 1 }
      stripped = line; sub(/^\*\*/, "", stripped)
      if (stripped ~ /^[0-9]+[.)]/) { emit(); block = line; opener = "item"; next }
      if (line ~ /^###/) { emit(); block = line; opener = "item"; next }
      if (line ~ /^[-*] / && opener != "item") { emit(); block = line; opener = "bullet"; next }
      if (block == "") { block = line; opener = "text" } else { block = block "\n" line }
    }
    END {
      if (bad) exit 2
      if (!seen_header) {
        print "finding: the answer has no '\''## Findings'\'' header; absence is not a clean review" > "/dev/stderr"; exit 2
      }
      if (inside) emit()
      if (bad) exit 2
      if (content == 0) {
        print "finding: the '\''## Findings'\'' header has neither a finding nor '\''No findings.'\'' under it" > "/dev/stderr"; exit 2
      }
      # Printed only once every block has been read, so a refusal prints no
      # half-read list that a caller could mistake for the findings.
      printf "%s", out
    }
  '
}

note() { printf 'note: %s\n' "$*" >&2; }

# Each parse line with a sixth field: introduced or pre-existing. The answer
# comes from the hunks of the branch diff against the base, read with no
# context lines, and not from blame: a finding whose range touches or sits one
# line from any hunk of its file is introduced, deletions included, since the
# line after a deleted check is where the missing check now bites. A deletion
# at new-side line n covers n-1 to n. Pre-existing only when the whole range is
# clear of every hunk, or the file is untouched. A finding with no location,
# and every finding when the diff cannot be read, is introduced: the error is
# on the blocking side.
label() {  # $1 base
  local parsed hunks readable=1
  parsed="$(parse)" || exit $?
  [ -n "$parsed" ] || return 0
  hunks="$(mktemp)" || finding "cannot create a temporary file"
  if ! git diff -U0 --no-color --no-ext-diff --src-prefix=a/ --dst-prefix=b/ "origin/$1...HEAD" > "$hunks" 2>/dev/null; then
    note "cannot read the diff against origin/$1; every finding is labelled introduced"
    readable=0
  fi
  # The hunks are read in BEGIN rather than as a first file: awk's usual
  # two-file idiom reads the second file as the first when the first is empty,
  # and an empty diff is exactly the case where every finding is pre-existing.
  printf '%s\n' "$parsed" | awk -F '\t' -v readable="$readable" -v hunks="$hunks" '
    function same_file(a, b) {
      sub(/^\.\//, "", a)
      return a == b || substr(b, length(b) - length(a)) == "/" a || substr(a, length(a) - length(b)) == "/" b
    }
    BEGIN {
      n = 0; f = ""; old = ""
      while ((getline line < hunks) > 0) {
        if (line ~ /^--- /) { old = line; sub(/^--- /, "", old); sub(/^a\//, "", old); continue }
        if (line ~ /^\+\+\+ /) {
          f = line; sub(/^\+\+\+ /, "", f)
          if (f == "/dev/null") f = old; else sub(/^b\//, "", f)
          continue
        }
        if (line ~ /^@@ /) {
          match(line, /\+[0-9]+(,[0-9]+)?/)
          spec = substr(line, RSTART + 1, RLENGTH - 1)
          count = (split(spec, p, ",") > 1) ? p[2] + 0 : 1
          start = p[1] + 0
          n++
          hf[n] = f
          if (count == 0) { hlo[n] = start - 1; hhi[n] = start }
          else { hlo[n] = start; hhi[n] = start + count - 1 }
        }
      }
      close(hunks)
    }
    {
      verdict = "pre-existing"
      if (!readable || $3 == "-") verdict = "introduced"
      else {
        k = split($4, r, "-"); lo = r[1] + 0; hi = (k > 1) ? r[2] + 0 : lo
        for (i = 1; i <= n; i++)
          if (same_file($3, hf[i]) && lo - 1 <= hhi[i] && hi + 1 >= hlo[i]) { verdict = "introduced"; break }
      }
      print $0 "\t" verdict
    }'
  rm -f "$hunks"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  parse)
    [ $# -eq 0 ] || finding "$usage"
    parse || exit $? ;;
  label)
    [ $# -eq 1 ] || finding "$usage"
    label "$1" ;;
  '') finding "$usage" ;;
  *) finding "$usage" ;;
esac
exit 0
